# Copy to .env for local development. Never commit real secrets.

# API
HOST=127.0.0.1
PORT=8787
VEKTOR_DATA_DIR=.data
VEKTOR_ENABLE_DEV_STREAM=1
VEKTOR_LOG_LEVEL=info

# Attachment limits: 25 MB per file, 250 MB per channel, up to 50 files per channel.
VEKTOR_MAX_FILE_BYTES=26214400
VEKTOR_CHANNEL_FILE_BYTES=262144000

# Runtime: applies to provider streaming, tool execution, and approval waits.
VEKTOR_RUN_TIMEOUT_MS=120000
# Use host for a directly launched backend. The Docker image sets container.
VEKTOR_RUNTIME_ENV=host

# Durable cron scheduler (five-field cron; minimum resolution is one minute).
VEKTOR_SCHEDULER_ENABLED=1
VEKTOR_SCHEDULER_TICK_MS=1000

# JSON logs: current file plus four archives, 10 MiB per file, under data/logs.
VEKTOR_LOG_FILE=1
VEKTOR_LOG_MAX_BYTES=10485760
VEKTOR_LOG_RETAINED_FILES=5

# Generated at $VEKTOR_DATA_DIR/access-token when unset.
# VEKTOR_ACCESS_TOKEN=

# Provider spike. Without a key, the stub provider is used.
# VEKTOR_OPENROUTER_KEY=
VEKTOR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VEKTOR_OPENROUTER_MODEL=openrouter/auto
