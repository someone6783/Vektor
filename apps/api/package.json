{
  "name": "@vektor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^8.2.0",
    "@vektor/db": "workspace:*",
    "@vektor/shared": "workspace:*",
    "fastify": "^5.6.2",
    "image-size": "^2.0.4",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "jszip": "^3.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
