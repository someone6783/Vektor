{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local workspace transport and native notifications for the bundled UI.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://[\\:\\:1]:*/*" },
        { "url": "https://127.0.0.1:*/*" },
        { "url": "https://localhost:*/*" },
        { "url": "https://[\\:\\:1]:*/*" }
      ]
    }
  ]
}
